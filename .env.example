# --- LLM: mock | anthropic | bedrock -----------------------------------------
#   mock      -> no keys needed, deterministic (local dev + CI pipeline tests)
#   anthropic -> Claude API (ANTHROPIC_API_KEY)
#   bedrock   -> Claude on Amazon Bedrock (AWS credentials + AWS_REGION)
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
AWS_REGION=us-east-1
# mantle = Bedrock Messages API client (default) | invoke = legacy InvokeModel client
BEDROCK_CLIENT=mantle
AGENT_MODEL=claude-opus-5
RETRIEVER_EFFORT=low
REVIEWER_EFFORT=high
FIXER_EFFORT=medium
VERIFIER_EFFORT=high

# --- RAG: local (BM25 over knowledge_base/) | bedrock_kb ----------------------
RAG_BACKEND=local
BEDROCK_KB_ID=

# --- GitHub (optional locally; fixtures are used without it) ------------------
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=
# Required x-api-key header for /reviews when set (always set it when deployed)
API_KEY=

# --- Guardrails ----------------------------------------------------------------
MAX_DIFF_CHARS=200000
MIN_CONFIDENCE_TO_POST=0.5
MAX_FIX_LINES=8

# --- Human in the loop: always | unverified_only | never ----------------------
HITL_MODE=always
HITL_BACKEND=sqlite

# --- Tools: inprocess | stdio (MCP server) ------------------------------------
MCP_MODE=inprocess
